# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# You can use either DATABASE_URL or individual parameters
# DATABASE_URL=postgresql://user:password@localhost:5432/kiit_mh

# Auth Mode: 'password' (production/default) or 'trust' (local dev only)
DB_AUTH_MODE=trust

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret_password_here
DB_NAME=kiit_mh

# Security
# Must be a 32-character string for AES-256
ENCRYPTION_KEY=01234567890123456789012345678901
JWT_SECRET=your_jwt_secret_key_change_me_in_prod
